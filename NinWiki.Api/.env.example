ENVIRONMENT=development

POSTGRES_USER=ninwiki
POSTGRES_PASSWORD=troque_essa_senha
POSTGRES_DB=ninwiki
POSTGRES_HOST=localhost
# 5433, nao 5432 - evita conflito com um Postgres nativo instalado fora do Docker
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://ninwiki:troque_essa_senha@localhost:5433/ninwiki

# ---- TLS com certificado de cliente (banco da SquareCloud) - deixe VAZIO para o banco local ----
# Baixe os 3 arquivos no painel do banco (Certificate CA .crt, PEM .pem, Private Key .key), coloque na pasta
# NinWiki.Api/certs/ (ela e' ignorada pelo Git) e aponte aqui. EM PRODUCAO nao use arquivos: cole o TEXTO (-----BEGIN ...) de cada um
# na variavel correspondente do painel da SquareCloud (quebras de linha podem vir como \n). Se o .pem ja' tiver a chave dentro, deixe KEY vazio.
# Com isto ligado, NAO ponha ?ssl=... na DATABASE_URL.
# DATABASE_SSL_CA=certs/ca.crt
# DATABASE_SSL_CERT=certs/client.pem
# DATABASE_SSL_KEY=certs/client.key
# Confere tambem o NOME do host no certificado do banco (so' ligue se o certificado dele bater com o host):
# DATABASE_SSL_VERIFY_HOSTNAME=false

JWT_SECRET_KEY=troque_por_uma_chave_aleatoria_longa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

FRONTEND_ORIGIN=http://localhost:3000

# URL publica desta propria API - usada para montar o link de imagens
# enviadas por upload (app/api/uploads.py). Em producao, vira o dominio
# real da API.
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=5
# Tamanho maximo (MB) de arquivo anexado a um aviso do quadro da equipe (aceita .zip, .rar, .7z, PDFs, imagens...).
MAX_NOTICE_FILE_MB=200

# ---- Traducao automatica (DeepL) ----
# Chave da API da DeepL (https://www.deepl.com/pro-api - o plano gratuito serve; chaves
# gratuitas terminam em ":fx"). Traduz o conteudo EN -> PT-BR ao salvar no painel.
# Vazio = a traducao automatica fica desligada (os campos _pt so' sao preenchidos a mao);
# a API funciona normalmente sem a chave.
DEEPL_API_KEY=

# ---- Fase 2: login e cargos (S.Adm / Adm / Creator) ----
# Duracao da sessao do painel, em horas.
SESSION_HOURS=12
# Discord IDs (separados por virgula) dos DONOS do sistema: viram S.Adm no
# primeiro login e nao podem ser rebaixados pelo painel/bot. Pra achar seu ID:
# Discord > Configuracoes > Avancado > Modo Desenvolvedor, depois botao direito
# no seu nome > Copiar ID do usuario.
SUPER_ADMIN_DISCORD_IDS=
# SO' PARA TESTAR LOCALMENTE sem Discord (entra so' com o Discord ID).
# A API RECUSA INICIAR se isso estiver true com ENVIRONMENT diferente de development.
# Exige 2FA ligado na conta do Discord de quem entra no painel (true = exige). Ative o 2FA na SUA conta antes de subir em producao.
REQUIRE_DISCORD_2FA=true
DEV_LOGIN_ENABLED=false
# Senha entre a API e o NinWiki.Bot (vazio = rotas do bot desligadas). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_API_TOKEN=
# Atras de proxy (SquareCloud / Cloudflare) coloque TRUE: a API passa a ler o IP real do visitante (CF-Connecting-IP
# ou o ULTIMO X-Forwarded-For) para o log e para o limite por IP. Rodando local, deixe false.
TRUST_PROXY_HEADERS=false
# Cookie de sessao: lax (padrao; site e API no MESMO dominio, ex: wiki.x.com + api.x.com). Se for usar enderecos
# *.squareweb.app (sites diferentes) ponha none - exige HTTPS e nao funciona em navegadores que bloqueiam cookie de terceiros.
# COOKIE_SAMESITE=lax

# ---- Protecao contra abuso (limites POR IP, POR MINUTO) - estes sao os valores padrao; so' descomente pra mudar ----
# O site busca os dados no servidor, entao as visitas chegam com o IP do servidor do site: por isso o limite de
# leitura e' alto. Muitos 429 para visitantes normais? Aumente.
# PUBLIC_REQUESTS_PER_MINUTE=1200
# UPLOAD_REQUESTS_PER_MINUTE=1500
# WRITE_REQUESTS_PER_MINUTE=120
# MEDIA_UPLOAD_REQUESTS_PER_MINUTE=600   # envio de imagens (inclusive em lote)
# MAX_JSON_BODY_KB=512
# Limite de tentativas de login (por IP). Estes sao os valores padrao - so' descomente pra mudar.
# LOGIN_REQUESTS_PER_MINUTE=30
# LOGIN_FAIL_LIMIT=5
# LOGIN_FAIL_WINDOW_MINUTES=15
# BOT_FAIL_LIMIT=10
# BOT_LOG_SHOW_IP=false   # true = a API deixa o bot mostrar o IP de quem agiu no canal de log (precisa de LOG_SHOW_IP=true no bot tambem)

# ---- Importador de noticias da Steam (opcional) ----
# Preenchido = a API confere as noticias do jogo na Steam e copia para o blog (tag "Patch Notes") cada post de atualizacao novo.
# O numero e' o da pagina do jogo: store.steampowered.com/news/app/1674010  ->  1674010. Vazio = desligado.
# STEAM_NEWS_APP_ID=1674010
# STEAM_NEWS_AUTHOR_NAME=Nome da Desenvolvedora   # mostrado em "por/by" no blog (vazio = o autor que a Steam informa)
# STEAM_NEWS_STATUS=published                      # published = vai ao ar na hora | draft = entra como rascunho para revisar
# STEAM_NEWS_REQUIRE_TAG=patchnotes                # so' posts com esta tag da Steam OU com titulo de update (abaixo); vazio = todos
# STEAM_NEWS_TITLE_PATTERN=update|patch|hotfix|\bv?\d+\.\d+(\.\d+)*[a-z]?\b   # expressao regular do titulo (a Steam nem sempre marca como patchnotes); vazio = so' a tag
# STEAM_NEWS_INTERVAL_MINUTES=30                   # de quanto em quanto tempo conferir (minimo 10)
# STEAM_NEWS_MAX_PER_RUN=5                         # teto de posts novos por conferencia (a 1a vez nao inunda o blog)

# ---- Backup (banco + imagens) feito pelo bot (opcional) ----
# A senha cifra o arquivo (ele leva IDs do Discord e IPs do log). Vazio = backups DESLIGADOS (a API nunca gera sem senha). GUARDE-A num gerenciador de senhas:
# sem ela o backup nao abre. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BACKUP_PASSPHRASE=
# BACKUP_EXCLUDE_TABLES=traffic_visitors,error_events   # tabelas descartaveis que ficam fora do backup

# --- Manutencao automatica (apaga o que ficou velho e inutil; app/core/maintenance.py) ---
# De quantas em quantas horas roda (0 = desligada). A primeira rodada acontece 5 minutos depois de a API subir.
MAINTENANCE_INTERVAL_HOURS=6
# Problemas do registro de erros: os JA' RESOLVIDOS somem depois de N dias; qualquer um sem ocorrer ha' N dias tambem some.
ERROR_RETENTION_DAYS_RESOLVED=30
ERROR_RETENTION_DAYS=90
# Log geral (quem fez o que): linhas com mais de N dias somem (0 = nunca apaga).
AUDIT_RETENTION_DAYS=365

# Banner do topo dos posts importados da Steam (o mesmo para todos): caminho do site ou endereco https. Vazio = sem banner (usa a capa).
STEAM_NEWS_BANNER_IMAGE=/images/blog/steam-banner.webp
