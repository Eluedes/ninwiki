# Imagem do site (Next.js, saida "standalone"). Build: docker build -f Azure/Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=... NinWiki.Web
# ATENCAO: variaveis NEXT_PUBLIC_* sao GRAVADAS no site na hora do build (nao mudam so' reiniciando): passe-as como --build-arg.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=""
ARG NEXT_PUBLIC_BUILD_SHA=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=$NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA \
    STANDALONE_BUILD=true NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
# Mesma montagem do workflow da SquareCloud: standalone + .next/static + public. Dono root, leitura para todos; roda como "node" (uid 1000).
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
