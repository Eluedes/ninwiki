# =====================================================================================================
# Nin Codex / NinWiki no Azure - arquivo de configuracao da VM.   COPIE para ".env" (na VM) e preencha.
#   cp .env.example .env && chmod 600 .env
# NUNCA coloque o ".env" no Git, em chat, print ou e-mail. Aqui so' ha' PLACEHOLDERS (troque tudo que esta entre < >).
# Gere segredos aleatorios na VM com:   openssl rand -hex 32     (so' letras/numeros: seguro dentro de URLs)
# =====================================================================================================

# ---- Dominios (sem https://) -----------------------------------------------------------------------
SITE_HOST=nincodex.guima.net
API_HOST=api.guima.net

# ---- Imagens (GitHub Container Registry) ---------------------------------------------------------
# Seu usuario/organizacao do GitHub em MINUSCULAS.
GHCR_OWNER=<seu-usuario-github-minusculo>
IMAGE_TAG=latest

# ---- Banco (Postgres no proprio compose; NAO publica porta) --------------------------------------
POSTGRES_USER=ninwiki
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=ninwiki

# ---- Cloudflare Tunnel ----------------------------------------------------------------------------
# Token do tunel (Zero Trust > Networks > Tunnels > seu tunel > Docker). E' SECRETO: quem o tem se passa pelo seu site.
CLOUDFLARE_TUNNEL_TOKEN=<token-do-tunel>

# ---- API ------------------------------------------------------------------------------------------
# (DATABASE_URL e' montada pelo docker-compose.yml a partir de POSTGRES_*: nao precisa escrever aqui.)
JWT_SECRET_KEY=<openssl rand -hex 32>
BOT_API_TOKEN=<openssl rand -hex 32>
# Senha do backup cifrado que o bot guarda no Discord (a API recusa gerar backup sem ela). GUARDE num gerenciador de senhas.
BACKUP_PASSPHRASE=<openssl rand -hex 32>

# Login com Discord (https://discord.com/developers/applications). Redirect da aplicacao: https://<API_HOST>/auth/discord/callback
DISCORD_CLIENT_ID=<id-da-aplicacao-discord>
DISCORD_CLIENT_SECRET=<segredo-da-aplicacao-discord>
# Opcional: vazio = a API monta sozinha a partir de API_BASE_URL
DISCORD_REDIRECT_URI=
SUPER_ADMIN_DISCORD_IDS=<seu-discord-id>
REQUIRE_DISCORD_2FA=true

# Enderecos PUBLICOS (com https://, sem "/" no fim)
FRONTEND_ORIGIN=https://nincodex.guima.net
# Origens extras (so' na transicao de endereco). Vazio = so' a principal.
FRONTEND_ORIGINS=
API_BASE_URL=https://api.guima.net

# IP real do visitante: so' vale se a conexao vier de um proxy NESTA lista. 172.28.0.0/24 = a rede interna fixa do compose.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=172.28.0.0/24
# lax funciona porque site e API sao do MESMO dominio registravel (nincodex.guima.net + api.guima.net). NAO use none.
COOKIE_SAMESITE=lax
MAX_UPLOAD_SIZE_MB=5

# Opcionais
DEEPL_API_KEY=
STEAM_NEWS_APP_ID=

# ---- Site (Next.js) -------------------------------------------------------------------------------
# Estas 3 sao GRAVADAS no site na hora do BUILD (GitHub: Settings > Secrets and variables > Actions > aba Variables).
# Estao aqui so' para voce nao esquecer os valores; mudar so' neste arquivo NAO muda o site.
#   NEXT_PUBLIC_API_URL=https://api.guima.net
#   NEXT_PUBLIC_SITE_URL=https://nincodex.guima.net
#   NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=<id-do-bot-para-o-link-de-convite>
# Em runtime (opcionais):
LEGACY_SITE_HOSTS=ninwiki.guima.net
BLOCK_SCRAPER_UAS=
WEB_RATE_LIMIT_PER_MINUTE=

# ---- Bot de Discord --------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=<token-do-bot>
DEV_GUILD_ID=
ALLOWED_GUILD_IDS=
LOG_CHANNEL_ID=
ERROR_CHANNEL_ID=
STATUS_CHANNEL_ID=
BACKUP_CHANNEL_ID=
SITE_URL=https://nincodex.guima.net
SITE_HEALTH_URL=
VERSION_WEBHOOK_URL=

# ---- Backup para o Azure Blob Storage (scripts/backup.sh) -----------------------------------------
STORAGE_ACCOUNT=<nome-da-conta-de-storage>
STORAGE_CONTAINER=backups
# CHAVE PUBLICA do age (comeca com "age1..."): a VM so' CIFRA; a chave privada fica com voce (ver LEIA-ME).
AGE_RECIPIENT=<age1...>

# ---- Alertas (opcional) -----------------------------------------------------------------------------
# Webhook de um canal PRIVADO do Discord: scripts/monitorar.sh avisa disco cheio / container doente / backup falhou.
ALERT_DISCORD_WEBHOOK=
