# Copie este arquivo para .env.local (nunca versionado) e ajuste se
# precisar. NEXT_PUBLIC_ e' o prefixo que o Next.js exige para uma
# variavel ficar disponivel no NAVEGADOR (componentes 'use client') -
# sem esse prefixo, a variavel so' existiria no lado do servidor.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Endereco publico do SITE (usado no sitemap, no RSS, nos links de compartilhamento e como dominio dos videos da Twitch).
# Em producao: https://wiki.seudominio.com   (embutido no build, como a NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Protecao do site (proxy.ts) - opcionais, valores padrao abaixo ----
# Maximo de paginas por minuto por IP; passou disso -> 429.
# WEB_RATE_LIMIT_PER_MINUTE=300
# Bloqueia robos de copia conhecidos (curl, python-requests, scrapy, headless...). false = desliga.
# BLOCK_SCRAPER_UAS=true
