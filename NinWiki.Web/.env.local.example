# Copie este arquivo para .env.local (nunca versionado) e ajuste se
# precisar. NEXT_PUBLIC_ e' o prefixo que o Next.js exige para uma
# variavel ficar disponivel no NAVEGADOR (componentes 'use client') -
# sem esse prefixo, a variavel so' existiria no lado do servidor.
NEXT_PUBLIC_API_URL=http://localhost:8000
