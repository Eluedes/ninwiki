# ---- NinWiki.Bot ----
# Copie este arquivo para ".env" (na pasta NinWiki.Bot) e preencha.
# O .env NUNCA vai pro Git.

# Token do BOT no Discord: Developer Portal > sua aplicacao > Bot > Reset Token.
# (NAO e' o Client Secret do login - sao coisas diferentes.)
DISCORD_BOT_TOKEN=

# Onde a NinWiki.Api esta rodando.
NINWIKI_API_URL=http://localhost:8000

# Senha combinada entre o bot e a API: tem que ser EXATAMENTE igual ao
# BOT_API_TOKEN do .env da NinWiki.Api. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Quem tem este valor consegue agir como qualquer staff: trate como senha.
BOT_API_TOKEN=

# (opcional) ID do SEU servidor de testes: os comandos aparecem na hora la'.
# Sem isso, os comandos globais podem levar ate 1 hora pra aparecer no Discord.
DEV_GUILD_ID=

# (opcional) Servidores onde os comandos sao aceitos, separados por virgula.
# Vazio = qualquer servidor onde o bot estiver. Recomendado preencher.
ALLOWED_GUILD_IDS=

# ---- Log geral no Discord (opcional) ----
# ID do canal onde o bot posta o que acontece no painel (quem criou/editou/apagou, logins, mudancas
# de equipe e de permissoes, tentativas negadas). Vazio = desligado. Pra pegar o ID: Discord >
# Configuracoes > Avancado > Modo Desenvolvedor, botao direito no canal > Copiar ID do canal.
# O bot precisa de "Ver canal", "Enviar mensagens" e "Inserir links" NESSE canal. Deixe o canal
# visivel so' pra' equipe: o log mostra nomes de quem fez cada acao (nunca IPs nem textos de conteudo).
LOG_CHANNEL_ID=
# De quantos em quantos segundos conferir se ha' acao nova (minimo 10).
LOG_POLL_SECONDS=20
# Mostra o IP de quem fez cada acao no canal de log (padrao: true). O canal precisa ser visivel SO' para a equipe;
# ponha false se qualquer pessoa de fora da equipe puder ler esse canal.
LOG_SHOW_IP=true
# Acoes que NAO devem aparecer no canal, separadas por virgula. Ex: login,logout (menos ruido).
LOG_IGNORE_ACTIONS=

# ---- Erros e problemas do wiki no Discord (opcional) ----
# Canal que recebe: erros da API/site/DeepL, alertas de flood e avisos "API/banco/site fora do ar" (e "voltou").
# Vazio = usa o canal do LOG_CHANNEL_ID acima; sem nenhum dos dois = desligado. Recomendado um canal so' de
# alertas (so' a equipe tecnica), porque aqui vao nomes de rotas e mensagens de erro (mascaradas, nunca segredos/IPs).
ERROR_CHANNEL_ID=
# Canal SO' do monitor: o painel "NinWiki status" e os avisos "API/banco/site fora do ar" e "voltou" - assim eles nao se misturam com os erros do wiki.
# Vazio = usa o ERROR_CHANNEL_ID (ou o canal de log).
STATUS_CHANNEL_ID=
# Endereco publico do site (ex: https://wiki.seudominio.com) - o bot confere de tempos em tempos se esta' no ar.
SITE_URL=
# (opcional) Endereco so' da checagem de saude: o da hospedagem direto (ex.: https://ninwiki.squareweb.app), sem Cloudflare na frente.
# Vazio = checa o SITE_URL. Os botoes do /search continuam apontando para o SITE_URL.
SITE_HEALTH_URL=
# Painel ao vivo: UMA mensagem "NinWiki status" no canal de status, editada a cada checagem (online/offline, ms, uptime). false = so' avisa quando cai/volta.
STATUS_PANEL=true
# true = alem do painel, manda uma mensagem NOVA a cada "caiu" / "voltou". Padrao false (o painel se edita sozinho e nao enche o canal).
STATUS_ALERTS=false
# Quantas checagens SEGUIDAS precisam falhar para avisar "caiu" (padrao 3). Suba (ex.: 5) se a rede oscila e o bot avisa demais.
STATUS_DOWN_AFTER=3
# De quantos em quantos segundos conferir API/banco/site (minimo 30).
HEALTH_POLL_SECONDS=60
